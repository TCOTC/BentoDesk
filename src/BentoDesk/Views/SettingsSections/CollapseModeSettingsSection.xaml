<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BentoDesk.Views.SettingsSections.CollapseModeSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BentoDesk.Controls"
    xmlns:svc="using:BentoDesk.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CollapseGroupTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingTitleTextStyle}">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Margin" Value="4,14,4,4" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Style="{StaticResource SectionPanelStyle}">
        <TextBlock Style="{StaticResource SectionTitleTextStyle}" svc:Localized.Key="Settings.Section.CollapseMode" />
        <StackPanel Margin="0,8,0,0" Spacing="4">
            <TextBlock Style="{StaticResource CollapseGroupTitleStyle}" svc:Localized.Key="Settings.Collapse.Group.Common" />

            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Settings.CollapseBehavior.Description"
                svc:Localized.HeaderKey="Settings.CollapseBehavior.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE73F;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="{StaticResource SettingsControlMinWidth}"
                    ItemsSource="{Binding AvailableWidgetCollapseBehaviorOptions}"
                    controls:SettingsComboBox.Value="{Binding SelectedWidgetCollapseBehavior, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <TextBlock Style="{StaticResource CollapseGroupTitleStyle}" svc:Localized.Key="Settings.Collapse.Group.Details" />

            <Border
                Style="{StaticResource SettingsGroupStyle}"
                Visibility="{Binding CollapseHoverResponseEntryVisibility}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="4">
                    <Button
                        Grid.Column="0"
                        Click="NestedSettingsButton_Click"
                        IsHitTestVisible="{Binding CanOpenWidgetCompactHoverResponseDetails}"
                        IsTabStop="{Binding CanOpenWidgetCompactHoverResponseDetails}"
                        Style="{StaticResource DrillDownRowStyle}"
                        Tag="CollapseBehaviorSettings">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <FontIcon Grid.Column="0" FontSize="18" Glyph="&#xE823;" IsHitTestVisible="False" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" IsHitTestVisible="False" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}" svc:Localized.Key="Settings.Collapse.HoverResponse.Title" />
                                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" svc:Localized.Key="Settings.Collapse.HoverResponse.Description" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="{StaticResource SettingsControlMinWidth}"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding AvailableWidgetCompactHoverResponseOptions}"
                        controls:SettingsComboBox.Value="{Binding SelectedWidgetCompactHoverResponse, Mode=TwoWay}" />
                    <FontIcon
                        Grid.Column="2"
                        FontSize="12"
                        Glyph="&#xE76C;"
                        IsHitTestVisible="False"
                        VerticalAlignment="Center"
                        Visibility="{Binding WidgetCompactHoverResponseCustomVisibility}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsGroupStyle}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="4">
                    <Button
                        Grid.Column="0"
                        Click="NestedSettingsButton_Click"
                        IsHitTestVisible="{Binding CanOpenWidgetCompactAnimationDetails}"
                        IsTabStop="{Binding CanOpenWidgetCompactAnimationDetails}"
                        Style="{StaticResource DrillDownRowStyle}"
                        Tag="CollapseAnimationSettings">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <FontIcon Grid.Column="0" FontSize="18" Glyph="&#xE7B5;" IsHitTestVisible="False" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" IsHitTestVisible="False" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}" svc:Localized.Key="Settings.Collapse.Animation.Title" />
                                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" svc:Localized.Key="Settings.Collapse.Animation.Description" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="{StaticResource SettingsControlMinWidth}"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding AvailableWidgetCompactAnimationEffectOptions}"
                        controls:SettingsComboBox.Value="{Binding SelectedWidgetCompactAnimationEffect, Mode=TwoWay}" />
                    <FontIcon
                        Grid.Column="2"
                        FontSize="12"
                        Glyph="&#xE76C;"
                        IsHitTestVisible="False"
                        VerticalAlignment="Center"
                        Visibility="{Binding WidgetCompactAnimationCustomVisibility}" />
                </Grid>
            </Border>

            <Border
                Style="{StaticResource SettingsGroupStyle}"
                Visibility="{Binding CollapseOverridesEntryVisibility}">
                <Button
                    Click="NestedSettingsButton_Click"
                    Style="{StaticResource DrillDownRowStyle}"
                    Tag="CollapseOverridesSettings">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <FontIcon Grid.Column="0" FontSize="18" Glyph="&#xE713;" IsHitTestVisible="False" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" IsHitTestVisible="False" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingTitleTextStyle}" svc:Localized.Key="Settings.Collapse.Overrides.Title" />
                            <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" Text="{Binding CollapseOverrideSummaryText}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" FontSize="12" Glyph="&#xE76C;" IsHitTestVisible="False" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
